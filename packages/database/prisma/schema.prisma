}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  displayName        String?
  passwordHash       String?
  passwordMustChange Boolean   @default(false)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  memberships TenantMembership[]
  staffSessions StaffSession[]

  @@index([deletedAt])
}

model BaseInterestRatePeriod {
  id                String    @id @default(uuid()) @db.Uuid
  validFrom         DateTime  @unique @db.Date
  validTo           DateTime? @db.Date
  rate              Decimal   @db.Decimal(7, 4)
  source            String
  sourceReference   String
  sourcePublishedAt DateTime?
  fetchedAt         DateTime
  sourceHash        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([validFrom, validTo])
}

model LegalReferenceSyncRun {
  id              String                   @id @default(uuid()) @db.Uuid
  sourceType      String
  startedAt       DateTime                 @default(now())
  finishedAt      DateTime?
  status          LegalReferenceSyncStatus @default(RUNNING)
  fetchedRecords  Int                      @default(0)
  insertedRecords Int                      @default(0)
  conflictRecords Int                      @default(0)
  errorMessage    String?
}

model RvgFeeScheduleVersion {
  id                      String               @id @default(uuid()) @db.Uuid
  identifier              String
  validFrom               DateTime             @db.Date
  validTo                 DateTime?            @db.Date
  legalReference          String
  sourceReference         String
  fetchedAt               DateTime
  sourceHash              String
  status                  RvgFeeScheduleStatus @default(PENDING_REVIEW)
  aboveMaximumIncrement   Decimal              @db.Decimal(15, 2)
  aboveMaximumFeeIncrease Decimal              @db.Decimal(15, 2)
  smallClaimCollectionFee Decimal?             @db.Decimal(15, 2)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  thresholds RvgFeeThreshold[]

  @@unique([identifier, validFrom])
  @@index([status, validFrom])
}

model RvgFeeThreshold {
  id                String  @id @default(uuid()) @db.Uuid
  scheduleVersionId String  @db.Uuid
  valueUpTo         Decimal @db.Decimal(15, 2)
  baseFee           Decimal @db.Decimal(15, 2)

  scheduleVersion RvgFeeScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, valueUpTo])
  @@index([scheduleVersionId, valueUpTo])
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships        TenantMembership[]
  teams              Team[]
  roles              Role[]
  debtors            Debtor[]
  parties            Party[]
  cases              Case[]
  claims             Claim[]
  sequences          CaseNumberSequence[]
  ledgerEntries      CaseLedgerEntry[]
  costCalculations   CaseCostCalculation[]
  paymentAllocations PaymentAllocation[]
  documentTemplates  DocumentTemplate[]
  documents          CaseDocument[]
  documentDeliveries DocumentDelivery[]
  documentSettings   TenantDocumentSettings?
  tasks              CaseTask[]
  clientSubmissions ClientSubmission[]
  portalAccounts     PortalAccount[]
  clientContacts     ClientContact[]
  dataSubjectRequests DataSubjectRequest[]
  dataSubjectAccessExports DataSubjectAccessExport[]
  dataSubjectDataReviews DataSubjectDataReview[]
  installmentRequests InstallmentRequest[]
  installmentPlans    InstallmentPlan[]
  installmentPlanItems InstallmentPlanItem[]
  staffSessions       StaffSession[]
  activityEvents      ActivityEvent[]
  enforcementTitles   EnforcementTitle[]
  enforcementActions  EnforcementAction[]
  communications      CommunicationEvent[]
  communicationAttachments CommunicationAttachment[]
  bankImports         BankImport[]
  bankTransactions    BankTransaction[]

  @@index([deletedAt])
}

model Case {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @db.Uuid
  caseNumber         String
  sequenceYear       Int
  sequenceNumber     Int
  clientPartyId      String                @db.Uuid
  debtorPartyId      String                @db.Uuid
  ownerMembershipId  String?               @db.Uuid
  assignedMembershipId String?             @db.Uuid
  status             CaseStatus            @default(OPEN)
  phase              CasePhase             @default(NEW)
  priority           CasePriority          @default(NORMAL)
  openedAt           DateTime              @default(now())
  closedAt           DateTime?
  internalNotes      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientParty        Party                 @relation("CaseClient", fields: [clientPartyId], references: [id], onDelete: Restrict)
  debtorParty        Party                 @relation("CaseDebtor", fields: [debtorPartyId], references: [id], onDelete: Restrict)
  ownerMembership    TenantMembership?     @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  assignedMembership TenantMembership?     @relation("AssignedCases", fields: [assignedMembershipId], references: [id], onDelete: Restrict)
  claim              Claim?
  ledgerEntries      CaseLedgerEntry[]
  costCalculations   CaseCostCalculation[]
  paymentAllocations PaymentAllocation[]
  documents          CaseDocument[]
  documentDeliveries DocumentDelivery[]
  tasks              CaseTask[]
  acceptedSubmissions ClientSubmission[] @relation("AcceptedSubmissionCase")
  installmentRequests InstallmentRequest[]
  installmentPlans    InstallmentPlan[]
  activityEvents      ActivityEvent[]
  enforcementTitles   EnforcementTitle[]
  enforcementActions  EnforcementAction[]
  communications      CommunicationEvent[]
  bankTransactions     BankTransaction[]

  @@unique([tenantId, caseNumber])
  @@unique([tenantId, sequenceYear, sequenceNumber])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, phase, deletedAt])
  @@index([clientPartyId])
  @@index([debtorPartyId])
  @@index([ownerMembershipId])
  @@index([tenantId, assignedMembershipId, deletedAt])
}

model EnforcementTitle {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @db.Uuid
  caseId                String                 @db.Uuid
  type                  EnforcementTitleType
  status                EnforcementTitleStatus @default(DRAFT)
  courtOrAuthority      String?
  referenceNumber       String?
  titleDate             DateTime
  serviceDate           DateTime?
  enforceableFrom       DateTime?
  principalAmount       Decimal                @db.Decimal(15, 2)
  costAmount            Decimal                @default(0) @db.Decimal(15, 2)
  interestAmount        Decimal                @default(0) @db.Decimal(15, 2)
  interestRule          Json?
  titleTotal            Decimal                @db.Decimal(15, 2)
  notes                 String?
  createdByMembershipId String                 @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                Case             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  createdByMembership TenantMembership @relation("EnforcementTitleCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  actions             EnforcementAction[]

  @@index([tenantId, caseId, status])
  @@index([caseId, titleDate])
  @@index([createdByMembershipId])
}

model EnforcementAction {
  id                    String                  @id @default(uuid()) @db.Uuid
  tenantId              String                  @db.Uuid
  caseId                String                  @db.Uuid
  titleId               String                  @db.Uuid
  type                  EnforcementActionType
  status                EnforcementActionStatus @default(DRAFT)
  requestedAt           DateTime?
  completedAt           DateTime?
  referenceNumber       String?
  amountAtRequest       Decimal                 @db.Decimal(15, 2)
  notes                 String?
  createdByMembershipId String                  @db.Uuid
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                Case             @relation(fields: [caseId], references: [id], onDelete: Restrict)
  title               EnforcementTitle @relation(fields: [titleId], references: [id], onDelete: Restrict)
  createdByMembership TenantMembership @relation("EnforcementActionCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId, status])
  @@index([titleId, status])
  @@index([createdByMembershipId])
}

model CaseCostCalculation {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @db.Uuid
  caseId           String                    @db.Uuid
  type             CaseCostCalculationType
  status           CaseCostCalculationStatus @default(APPLIED)
  fingerprint      String
  calculatedAmount Decimal                   @db.Decimal(15, 2)
  referenceData    Json
  createdAt        DateTime                  @default(now())
  appliedAt        DateTime                  @default(now())
  reversedAt       DateTime?
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case             Case                      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  ledgerEntries    CaseLedgerEntry[]

  @@index([tenantId, caseId, type, status])
  @@index([caseId, fingerprint])
}

model CaseLedgerEntry {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  caseId                String            @db.Uuid
  side                  LedgerEntrySide
  type                  LedgerEntryType
  status                LedgerEntryStatus @default(ACTIVE)
  amount                Decimal           @db.Decimal(15, 2)
  currency              String            @default("EUR") @db.Char(3)
  bookingDate           DateTime          @db.Date
  valueDate             DateTime?         @db.Date
  description           String
  externalReference     String?
  source                String?
  reversedEntryId       String?           @unique @db.Uuid
  createdByMembershipId String?           @db.Uuid
  costCalculationId     String?           @db.Uuid
  allocationPolicy      AllocationPolicy?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Restrict)
  reversedEntry       CaseLedgerEntry?     @relation("LedgerReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversal            CaseLedgerEntry?     @relation("LedgerReversal")
  createdByMembership TenantMembership?    @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  costCalculation     CaseCostCalculation? @relation(fields: [costCalculationId], references: [id], onDelete: Restrict)
  paymentAllocations  PaymentAllocation[]  @relation("PaymentAllocations")
  targetAllocations   PaymentAllocation[]  @relation("TargetAllocations")
  bankTransaction     BankTransaction?

  @@index([tenantId, caseId, bookingDate])
  @@index([caseId, status])
  @@index([type])
  @@index([externalReference])
  @@index([createdByMembershipId])
  @@index([costCalculationId])
}

model PaymentAllocation {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  caseId          String                  @db.Uuid
  paymentEntryId  String                  @db.Uuid
  targetEntryId   String                  @db.Uuid
  amount          Decimal                 @db.Decimal(15, 2)
  policy          AllocationPolicy
  allocationOrder Int
  status          PaymentAllocationStatus @default(ACTIVE)
  createdAt       DateTime                @default(now())
  reversedAt      DateTime?

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case         Case            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  paymentEntry CaseLedgerEntry @relation("PaymentAllocations", fields: [paymentEntryId], references: [id], onDelete: Restrict)
  targetEntry  CaseLedgerEntry @relation("TargetAllocations", fields: [targetEntryId], references: [id], onDelete: Restrict)

  @@unique([paymentEntryId, targetEntryId])
  @@unique([paymentEntryId, allocationOrder])
  @@index([tenantId, caseId, status])
  @@index([targetEntryId, status])
}

model BankImport {
  id                     String           @id @default(uuid()) @db.Uuid
  tenantId               String           @db.Uuid
  fileName               String
  fileFormat             BankFileFormat
  fileHash               String
  storageKey             String
  mimeType               String
  fileSize               Int
  status                 BankImportStatus @default(PROCESSING)
  importedByMembershipId String           @db.Uuid
  importedAt             DateTime         @default(now())
  transactionCount       Int              @default(0)
  matchedCount           Int              @default(0)
  bookedCount            Int              @default(0)
  reviewCount            Int              @default(0)
  duplicateCount         Int              @default(0)
  errorCount             Int              @default(0)
  errorMessage           String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  importedBy   TenantMembership  @relation("BankImportImportedBy", fields: [importedByMembershipId], references: [id], onDelete: Restrict)
  transactions BankTransaction[]

  @@unique([tenantId, fileHash])
  @@index([tenantId, importedAt])
  @@index([tenantId, status, importedAt])
  @@index([importedByMembershipId])
}

model BankTransaction {
  id                     String                   @id @default(uuid()) @db.Uuid
  tenantId               String                   @db.Uuid
  bankImportId           String                   @db.Uuid
  externalTransactionId  String?
  bookingDate            DateTime                 @db.Date
  valueDate              DateTime?                @db.Date
  amount                 Decimal                  @db.Decimal(15, 2)
  currency               String                   @db.Char(3)
  direction              BankTransactionDirection
  debtorName             String?
  debtorIban             String?
  creditorName           String?
  creditorIban           String?
  purpose                String
  bankReference          String?
  endToEndId             String?
  mandateReference       String?
  creditorReference      String?
  bankTransactionCode    String?
  transactionKey         String
  normalizedData         Json?
  status                 BankTransactionStatus    @default(IMPORTED)
  matchedCaseId          String?                  @db.Uuid
  matchedPartyId         String?                  @db.Uuid
  paymentId              String?                  @unique @db.Uuid
  duplicateOfId          String?                  @db.Uuid
  matchScore             Int?
  matchReason            String?
  ignoreReason           String?
  reviewedByMembershipId String?                  @db.Uuid
  reviewedAt             DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bankImport   BankImport        @relation(fields: [bankImportId], references: [id], onDelete: Restrict)
  matchedCase  Case?             @relation(fields: [matchedCaseId], references: [id], onDelete: Restrict)
  matchedParty Party?            @relation(fields: [matchedPartyId], references: [id], onDelete: Restrict)
  payment      CaseLedgerEntry?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reviewedBy   TenantMembership? @relation("BankTransactionReviewedBy", fields: [reviewedByMembershipId], references: [id], onDelete: Restrict)
  duplicateOf  BankTransaction?  @relation("BankTransactionDuplicate", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates   BankTransaction[] @relation("BankTransactionDuplicate")

  @@index([tenantId, status, bookingDate])
  @@index([tenantId, bankImportId, status])
  @@index([tenantId, transactionKey])
  @@index([tenantId, externalTransactionId])
  @@index([matchedCaseId])
  @@index([matchedPartyId])
  @@index([reviewedByMembershipId])
  @@index([duplicateOfId])
}

model DocumentTemplate {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String?        @db.Uuid
  key          String
  name         String
  type         DocumentType
  version      Int
  status       TemplateStatus @default(ACTIVE)
  subject      String?
  bodyTemplate String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents CaseDocument[]

  @@unique([tenantId, key, version])
  @@index([tenantId, status, type])
}

model TenantDocumentSettings {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @db.Uuid
  companyName        String
  legalName          String?
  street             String
  houseNumber        String?
  postalCode         String
  city               String
  country            String   @default("DE") @db.Char(2)
  phone              String?
  mobile             String?
  fax                String?
  email              String?
  website            String?
  registrationCourt  String?
  registrationNumber String?
  vatId              String?
  managingDirector   String?
  iban               String?
  bic                String?
  bankName           String?
  creditorId         String?
  collectionRegistrationAuthority String?
  collectionRegistrationAddress   String?
  collectionRegistrationContact   String?
  documentFooter     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
