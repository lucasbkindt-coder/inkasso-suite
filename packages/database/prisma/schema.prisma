generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum RoleKind {
  SYSTEM
  CUSTOM
}

enum PermissionScope {
  TENANT
  TEAM
  OWN
}

enum DebtorType {
  PERSON
  COMPANY
}

enum PartyType {
  PERSON
  COMPANY
}

enum PartyRoleType {
  CLIENT
  DEBTOR
  CONTACT
  OTHER
}

enum AddressType {
  PRIMARY
  DELIVERY
  BILLING
  PREVIOUS
  OTHER
}

enum ContactType {
  EMAIL
  PHONE
  MOBILE
  FAX
  WEBSITE
  OTHER
}

enum CaseStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CasePhase {
  NEW
  PRE_COLLECTION
  OUT_OF_COURT
  PAYMENT_PLAN
  JUDICIAL_DUNNING
  LITIGATION
  ENFORCEMENT
  MONITORING
  COMPLETED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ClaimStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  DISPUTED
  CANCELLED
}

enum LedgerEntrySide {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  PRINCIPAL
  INTEREST
  COLLECTION_FEE
  EXPENSE
  COURT_COST
  ENFORCEMENT_COST
  PAYMENT
  CREDIT_NOTE
  CORRECTION
  OTHER
}

enum LedgerEntryStatus {
  ACTIVE
  REVERSED
}

enum AllocationPolicy {
  BGB_367_DEFAULT
  CUSTOM
}

enum PaymentAllocationStatus {
  ACTIVE
  REVERSED
}

enum DocumentType {
  PAYMENT_REQUEST
  SECOND_PAYMENT_REQUEST
  JUDICIAL_DUNNING_NOTICE
  ENFORCEMENT_NOTICE
  PAYMENT_PLAN
  CUSTOM
}

enum DocumentStatus {
  DRAFT
  GENERATED
  SENT
  VOIDED
}

enum TemplateStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LegalReferenceSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SUCCEEDED_WITH_CONFLICTS
}

enum RvgFeeScheduleStatus {
  PENDING_REVIEW
  ACTIVE
  REJECTED
}

enum CaseCostCalculationType {
  RVG
  INTEREST
}

enum CaseCostCalculationStatus {
  APPLIED
  REVERSED
}

model User {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  displayName String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  memberships TenantMembership[]

  @@index([deletedAt])
}

model BaseInterestRatePeriod {
  id                String    @id @default(uuid()) @db.Uuid
  validFrom         DateTime  @unique @db.Date
  validTo           DateTime? @db.Date
  rate              Decimal   @db.Decimal(7, 4)
  source            String
  sourceReference   String
  sourcePublishedAt DateTime?
  fetchedAt         DateTime
  sourceHash        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([validFrom, validTo])
}

model LegalReferenceSyncRun {
  id              String                   @id @default(uuid()) @db.Uuid
  sourceType      String
  startedAt       DateTime                 @default(now())
  finishedAt      DateTime?
  status          LegalReferenceSyncStatus @default(RUNNING)
  fetchedRecords  Int                      @default(0)
  insertedRecords Int                      @default(0)
  conflictRecords Int                      @default(0)
  errorMessage    String?
}

model RvgFeeScheduleVersion {
  id                      String               @id @default(uuid()) @db.Uuid
  identifier              String
  validFrom               DateTime             @db.Date
  validTo                 DateTime?            @db.Date
  legalReference          String
  sourceReference         String
  fetchedAt               DateTime
  sourceHash              String
  status                  RvgFeeScheduleStatus @default(PENDING_REVIEW)
  aboveMaximumIncrement   Decimal              @db.Decimal(15, 2)
  aboveMaximumFeeIncrease Decimal              @db.Decimal(15, 2)
  smallClaimCollectionFee Decimal?             @db.Decimal(15, 2)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  thresholds RvgFeeThreshold[]

  @@unique([identifier, validFrom])
  @@index([status, validFrom])
}

model RvgFeeThreshold {
  id                String  @id @default(uuid()) @db.Uuid
  scheduleVersionId String  @db.Uuid
  valueUpTo         Decimal @db.Decimal(15, 2)
  baseFee           Decimal @db.Decimal(15, 2)

  scheduleVersion RvgFeeScheduleVersion @relation(fields: [scheduleVersionId], references: [id], onDelete: Cascade)

  @@unique([scheduleVersionId, valueUpTo])
  @@index([scheduleVersionId, valueUpTo])
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships        TenantMembership[]
  teams              Team[]
  roles              Role[]
  debtors            Debtor[]
  parties            Party[]
  cases              Case[]
  claims             Claim[]
  sequences          CaseNumberSequence[]
  ledgerEntries      CaseLedgerEntry[]
  costCalculations   CaseCostCalculation[]
  paymentAllocations PaymentAllocation[]
  documentTemplates  DocumentTemplate[]
  documents          CaseDocument[]

  @@index([deletedAt])
}

model Case {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @db.Uuid
  caseNumber         String
  sequenceYear       Int
  sequenceNumber     Int
  clientPartyId      String                @db.Uuid
  debtorPartyId      String                @db.Uuid
  ownerMembershipId  String?               @db.Uuid
  status             CaseStatus            @default(OPEN)
  phase              CasePhase             @default(NEW)
  priority           CasePriority          @default(NORMAL)
  openedAt           DateTime              @default(now())
  closedAt           DateTime?
  internalNotes      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clientParty        Party                 @relation("CaseClient", fields: [clientPartyId], references: [id], onDelete: Restrict)
  debtorParty        Party                 @relation("CaseDebtor", fields: [debtorPartyId], references: [id], onDelete: Restrict)
  ownerMembership    TenantMembership?     @relation(fields: [ownerMembershipId], references: [id], onDelete: Restrict)
  claim              Claim?
  ledgerEntries      CaseLedgerEntry[]
  costCalculations   CaseCostCalculation[]
  paymentAllocations PaymentAllocation[]
  documents          CaseDocument[]

  @@unique([tenantId, caseNumber])
  @@unique([tenantId, sequenceYear, sequenceNumber])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, phase, deletedAt])
  @@index([clientPartyId])
  @@index([debtorPartyId])
  @@index([ownerMembershipId])
}

model CaseCostCalculation {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @db.Uuid
  caseId           String                    @db.Uuid
  type             CaseCostCalculationType
  status           CaseCostCalculationStatus @default(APPLIED)
  fingerprint      String
  calculatedAmount Decimal                   @db.Decimal(15, 2)
  referenceData    Json
  createdAt        DateTime                  @default(now())
  appliedAt        DateTime                  @default(now())
  reversedAt       DateTime?
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case             Case                      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  ledgerEntries    CaseLedgerEntry[]

  @@index([tenantId, caseId, type, status])
  @@index([caseId, fingerprint])
}

model CaseLedgerEntry {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  caseId                String            @db.Uuid
  side                  LedgerEntrySide
  type                  LedgerEntryType
  status                LedgerEntryStatus @default(ACTIVE)
  amount                Decimal           @db.Decimal(15, 2)
  currency              String            @default("EUR") @db.Char(3)
  bookingDate           DateTime          @db.Date
  valueDate             DateTime?         @db.Date
  description           String
  externalReference     String?
  source                String?
  reversedEntryId       String?           @unique @db.Uuid
  createdByMembershipId String?           @db.Uuid
  costCalculationId     String?           @db.Uuid
  allocationPolicy      AllocationPolicy?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                Case                 @relation(fields: [caseId], references: [id], onDelete: Restrict)
  reversedEntry       CaseLedgerEntry?     @relation("LedgerReversal", fields: [reversedEntryId], references: [id], onDelete: Restrict)
  reversal            CaseLedgerEntry?     @relation("LedgerReversal")
  createdByMembership TenantMembership?    @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  costCalculation     CaseCostCalculation? @relation(fields: [costCalculationId], references: [id], onDelete: Restrict)
  paymentAllocations  PaymentAllocation[]  @relation("PaymentAllocations")
  targetAllocations   PaymentAllocation[]  @relation("TargetAllocations")

  @@index([tenantId, caseId, bookingDate])
  @@index([caseId, status])
  @@index([type])
  @@index([externalReference])
  @@index([createdByMembershipId])
  @@index([costCalculationId])
}

model PaymentAllocation {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  caseId          String                  @db.Uuid
  paymentEntryId  String                  @db.Uuid
  targetEntryId   String                  @db.Uuid
  amount          Decimal                 @db.Decimal(15, 2)
  policy          AllocationPolicy
  allocationOrder Int
  status          PaymentAllocationStatus @default(ACTIVE)
  createdAt       DateTime                @default(now())
  reversedAt      DateTime?

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case         Case            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  paymentEntry CaseLedgerEntry @relation("PaymentAllocations", fields: [paymentEntryId], references: [id], onDelete: Restrict)
  targetEntry  CaseLedgerEntry @relation("TargetAllocations", fields: [targetEntryId], references: [id], onDelete: Restrict)

  @@unique([paymentEntryId, targetEntryId])
  @@unique([paymentEntryId, allocationOrder])
  @@index([tenantId, caseId, status])
  @@index([targetEntryId, status])
}

model DocumentTemplate {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String?        @db.Uuid
  key          String
  name         String
  type         DocumentType
  version      Int
  status       TemplateStatus @default(ACTIVE)
  subject      String?
  bodyTemplate String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant    Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  documents CaseDocument[]

  @@unique([tenantId, key, version])
  @@index([tenantId, status, type])
}

model CaseDocument {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @db.Uuid
  caseId                String         @db.Uuid
  templateId            String?        @db.Uuid
  type                  DocumentType
  status                DocumentStatus @default(DRAFT)
  filename              String
  mimeType              String         @default("application/pdf")
  storageKey            String
  templateVersion       Int?
  renderedSubject       String?
  renderedBody          String
  dataSnapshot          Json
  generatedAt           DateTime       @default(now())
  sentAt                DateTime?
  voidedAt              DateTime?
  createdByMembershipId String?        @db.Uuid
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case                Case              @relation(fields: [caseId], references: [id], onDelete: Restrict)
  template            DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdByMembership TenantMembership? @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@index([tenantId, caseId, generatedAt])
  @@index([templateId])
  @@index([createdByMembershipId])
}

model Claim {
  id              String      @id @default(uuid()) @db.Uuid
  caseId          String      @unique @db.Uuid
  tenantId        String      @db.Uuid
  invoiceNumber   String
  invoiceDate     DateTime    @db.Date
  dueDate         DateTime    @db.Date
  defaultDate     DateTime?   @db.Date
  principalAmount Decimal     @db.Decimal(15, 2)
  currency        String      @default("EUR") @db.Char(3)
  description     String?
  status          ClaimStatus @default(OPEN)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  case            Case        @relation(fields: [caseId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, deletedAt])
  @@index([tenantId, invoiceNumber])
}

model CaseNumberSequence {
  tenantId   String   @db.Uuid
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, year])
}

model Party {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  type        PartyType
  displayName String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  person      Person?
  company     Company?
  roles       PartyRole[]
  addresses   Address[]
  contacts    Contact[]
  clientCases Case[]      @relation("CaseClient")
  debtorCases Case[]      @relation("CaseDebtor")

  @@index([tenantId, deletedAt, displayName])
  @@index([tenantId, type, deletedAt])
}

model Person {
  id         String    @id @default(uuid()) @db.Uuid
  partyId    String    @unique @db.Uuid
  salutation String?
  title      String?
  firstName  String
  lastName   String
  birthDate  DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([lastName, firstName])
}

model Company {
  id                 String   @id @default(uuid()) @db.Uuid
  partyId            String   @unique @db.Uuid
  companyName        String
  legalForm          String?
  vatId              String?
  taxNumber          String?
  commercialRegister String?
  registerNumber     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([companyName])
  @@index([vatId])
}

model PartyRole {
  id        String        @id @default(uuid()) @db.Uuid
  partyId   String        @db.Uuid
  role      PartyRoleType
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([partyId, role])
  @@index([role, deletedAt])
}

model Address {
  id           String      @id @default(uuid()) @db.Uuid
  partyId      String      @db.Uuid
  type         AddressType @default(PRIMARY)
  street       String
  houseNumber  String?
  addressLine2 String?
  postalCode   String
  city         String
  country      String      @default("DE") @db.Char(2)
  isPrimary    Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([partyId, deletedAt, isPrimary])
  @@index([postalCode, city])
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  partyId   String      @db.Uuid
  type      ContactType
  value     String
  label     String?
  isPrimary Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  party Party @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([partyId, deletedAt, isPrimary])
  @@index([partyId, type, deletedAt])
  @@index([value])
}

model Debtor {
  id          String     @id @default(uuid()) @db.Uuid
  tenantId    String     @db.Uuid
  type        DebtorType @default(PERSON)
  firstName   String?
  lastName    String?
  companyName String?
  email       String?
  phone       String?
  street      String?
  postalCode  String?
  city        String?
  country     String     @default("DE") @db.Char(2)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, deletedAt, createdAt])
  @@index([tenantId, type, deletedAt])
  @@index([tenantId, email])
  @@index([lastName, firstName])
  @@index([companyName])
}

model TenantMembership {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @db.Uuid
  userId    String           @db.Uuid
  status    MembershipStatus @default(INVITED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  teamMemberships      TeamMembership[]
  roleAssignments      MembershipRole[]
  ownedCases           Case[]
  createdLedgerEntries CaseLedgerEntry[]
  createdDocuments     CaseDocument[]

  @@unique([tenantId, userId])
  @@index([userId, deletedAt])
  @@index([tenantId, status, deletedAt])
}

model Team {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  members TeamMembership[]

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

model TeamMembership {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  membershipId String   @db.Uuid
  createdAt    DateTime @default(now())

  team       Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership TenantMembership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roles      TeamMembershipRole[]

  @@unique([teamId, membershipId])
  @@index([membershipId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  description String?
  kind        RoleKind  @default(CUSTOM)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant                    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions               RolePermission[]
  membershipAssignments     MembershipRole[]
  teamMembershipAssignments TeamMembershipRole[]

  @@unique([tenantId, name])
  @@index([tenantId, kind, deletedAt])
}

model Permission {
  id          String          @id @default(uuid()) @db.Uuid
  resource    String
  action      String
  scope       PermissionScope @default(TENANT)
  description String?
  createdAt   DateTime        @default(now())

  roles RolePermission[]

  @@unique([resource, action, scope])
  @@index([resource, action])
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model MembershipRole {
  membershipId String   @db.Uuid
  roleId       String   @db.Uuid
  createdAt    DateTime @default(now())

  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([roleId])
}

model TeamMembershipRole {
  teamMembershipId String   @db.Uuid
  roleId           String   @db.Uuid
  createdAt        DateTime @default(now())

  teamMembership TeamMembership @relation(fields: [teamMembershipId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([teamMembershipId, roleId])
  @@index([roleId])
}
