# PostgreSQL / Docker Compose
POSTGRES_DB=inkasso
POSTGRES_USER=inkasso
POSTGRES_PASSWORD=inkasso
POSTGRES_PORT=5432

# Application
API_PORT=3001
DATABASE_URL="postgresql://inkasso:inkasso@localhost:5432/inkasso?schema=public"

# Öffentliche Basis-URL für Aktivierungslinks in finalen Schuldnerschreiben.
# In Production muss HTTPS verwendet werden.
PORTAL_PUBLIC_BASE_URL=https://portal.example.invalid
# Optional for local WLAN testing, e.g. http://192.168.178.56:3000.
# Do not set a production domain before a TLS-enabled deployment exists.
RISEPAY_LAN_ORIGIN=

# Development-safe delivery transport. No external mail is sent.
MAIL_TRANSPORT=log
