# PostgreSQL / Docker Compose
POSTGRES_DB=inkasso
POSTGRES_USER=inkasso
POSTGRES_PASSWORD=inkasso
POSTGRES_PORT=5432

# Application
NODE_ENV=development
API_PORT=3001
DATABASE_URL="postgresql://inkasso:inkasso@localhost:5432/inkasso?schema=public"
# Server-side target for the Next.js local API rewrite. Keep this local; browser
# requests use the relative /api path and therefore work from the LAN as well.
RISEPAY_API_INTERNAL_URL=http://127.0.0.1:3001

# Öffentliche Basis-URL für Aktivierungslinks in finalen Schuldnerschreiben.
# In Production muss HTTPS verwendet werden.
PORTAL_PUBLIC_BASE_URL=https://portal.example.invalid
# Optional for local WLAN testing, e.g. http://192.168.178.56:3000.
# Do not set a production domain before a TLS-enabled deployment exists.
RISEPAY_LAN_ORIGIN=
DESK_PUBLIC_BASE_URL=http://localhost:3002

# Development-safe delivery transport. No external mail is sent.
MAIL_TRANSPORT=log

# Zoho Desk server-side integration. Leave empty until an OAuth self-client has
# been approved with read-only Desk scopes. Never expose these values to Next.js.
ZOHO_DESK_CLIENT_ID=
ZOHO_DESK_CLIENT_SECRET=
ZOHO_DESK_REFRESH_TOKEN=
ZOHO_DESK_ORG_ID=
# Supported values: EU, US, IN, AU, JP, CA
ZOHO_DESK_REGION=EU
